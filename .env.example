# LLM: siliconflow | ollama | deepseek | mock | openai_compatible
LLM_PROVIDER=siliconflow
LLM_MODEL=Qwen/Qwen3-32b
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-xxx
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
# LLM HTTP read timeout seconds (硅基流动/慢模型可调大)
LLM_TIMEOUT=300
# TLS verify for LLM/embedding HTTP. Set false only if proxy causes Hostname mismatch.
HTTP_VERIFY_SSL=true
LLM_LOG_PROMPTS=true
LLM_LOG_MAX_CHARS=8000
# Qwen3 思考链：打标签建议 false（更快）；需要深度推理可 true
LLM_ENABLE_THINKING=false
# 会话语义压缩（DSH 风格）：长会话把中间历史交给 LLM 压缩成摘要，
# 而不是硬截断丢弃。qwen3 上下文有限时建议开启。
COMPACTION_ENABLED=true
COMPACTION_THRESHOLD=14
COMPACTION_KEEP_TAIL=8

# Embedding（与 LLM 独立：PROVIDER / BASE_URL / API_KEY）
# siliconflow | hash | local | openai_compatible
# DeepSeek 没有 /embeddings，禁止指向 api.deepseek.com；API_KEY 留空则 hash 回退。
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=

# ===== 内网 Ollama 一键切换（qwen3:32b 等 GGUF 模型）=====
# 运行：python scripts/switch_ollama.py --apply
#   先拉模型：ollama pull qwen3:32b && ollama pull bge-m3
#   qwen3 没有 embedding 能力，必须另配向量模型（bge-m3=1024维 / nomic-embed-text=768维）。
#   切换 embedding 维度后：删 data/milvus_demo.db（lite 模式）再重新 ingest。
# 示例（注释掉上面的 siliconflow 块并取消下面注释）：
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:32b
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_API_KEY=ollama
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_DIM=1024
# MILVUS_MODE=lite
# ================================================


PROJECT_ID=demo-loan
PROJECT_ROOT=java_project/demo-loan
AGENT_WRITE_MODE=workspace
WORKSPACE_DIR=.agent_workspace
# standard = full skills; minimal = eval-friendly tool subset (no decompose / scaffold)
# agentscope = AgentScope 迁移层（agentscope_bridge，学习样板；docs/agentscope迁移方案.md）
AGENT_RUNTIME_MODE=standard
# agentscope 模式下的协作方式：空=单 ReActAgent；msghub=MsgHub 多智能体（探索+评审）
AGENTSCOPE_TEAM=
# agentscope 改码落地的失败反馈重试轮数（0=不重试；OLD 片段不匹配时模型修订重提）
AGENTSCOPE_MODIFY_RETRIES=2
# True: append [PEV][...]/契约缺口 internal debug tags into the user-visible
# answer (dev/testing only). Default False keeps user replies clean; the tags
# and verify gaps are still returned in result["pev_debug"].
PEV_TEST_TAGS_IN_ANSWER=false
AGENT_TRAJECTORY_ENABLED=true
AGENT_TRAJECTORY_DIR=data/trajectories
# When AGENT_RUNTIME_MODE=minimal: verify retries (0 = verify once, no auto-repair)
AGENT_MINIMAL_MAX_REPAIRS=0
TAGGING_ENABLED=true

# ===== 黄金问答库（方案一：离线预咀嚼，运行时命中即答）=====
# 内网只有 qwen3-32b 时，长链工具推理会掉准确率。方案：离线用思考模式生成
# 高置信问答对落 MySQL golden_qa 表；chat 对 ask 类问题先检索，命中高分直接
# 返回存储答案，qwen3 在线只做检索/组装。
# 生成：python scripts/generate_golden_qa.py （先 ingest，再跑本脚本）
GOLDEN_QA_ENABLED=true
# 命中阈值（0~1，语义0.65+关键词0.35 加权分），低于阈值走正常管线
GOLDEN_QA_MIN_SCORE=0.55
GOLDEN_QA_TOP_K=3
# 离线生成时每题采样数（自一致性投票）
GOLDEN_QA_N_SAMPLES=3
# 离线生成候选上限（0=自动）
GOLDEN_QA_MAX_CANDIDATES=300
# 候选上下文喂给模型的最大字符数（弱模型上下文有限）
GOLDEN_QA_CONTEXT_MAX_CHARS=2600
# 通用兜底：检索无命中（非代码问题）时直接用 LLM 回答，保证任何问题都有回复
GENERAL_FALLBACK_ENABLED=true

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=business_code_agent
# 调试时打印 SQL：MYSQL_ECHO=true
MYSQL_ECHO=false

# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Milvus: lite (local *.db) or server (docker compose etcd+minio+milvus)
# Do NOT set MILVUS_URI — pymilvus treats MILVUS_URI as server HTTP URI
# Start: docker compose up -d etcd minio milvus
MILVUS_MODE=server
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_LITE_PATH=data/milvus_demo.db
MILVUS_COLLECTION=method_embeddings
# Entry routing / classification (flow questions resolve Class#method first)
MILVUS_ENTRY_ROUTE_COLLECTION=entry_route
# false = 不用向量检索（流程题仍可走 MySQL FlowDoc / Neo4j FOLLOWS）
SEARCH_USE_MILVUS=true
# source = 纯 AI 规划 + 扫源码；index = 走索引库（推荐页面问答）
# 注意：即使 EXPLORE_BACKEND=source，同步/全链路「流程」题在 Neo4j FOLLOWS
# 或 MySQL FlowDoc 已有数据时仍会走 FOLLOWS 主链，避免 LLM 压成 4～5 步错序。
EXPLORE_BACKEND=index

# Keep caches on D:
HF_HOME=./.cache/huggingface
TRANSFORMERS_CACHE=./.cache/huggingface
TORCH_HOME=./.cache/torch

INGEST_BATCH_SIZE=20
# 打标签并发（异步 semaphore，适合 API 调用）
TAGGING_CONCURRENCY=8
# 解析文件并发（线程池）；topo AI 调度并发也用此值
PARSE_CONCURRENCY=12
# 全局 AST + 拓扑优先 AI（解析项目默认路径）
TOPO_AST_PIPELINE_ENABLED=true
TOPO_MAX_RETRIES=2
# 可选包根（逗号分隔，相对 PROJECT_ROOT）；空=整仓
TOPO_PACKAGE_ROOTS=
# 0=全量方法；试点可设 200
TOPO_MAX_METHODS=0
# false = Neo4j 不存方法业务描述（放 MySQL）；只留 symbol_id + CALLS.order
NEO4J_STORE_NARRATIVES=false
GRAPH_MAX_DEPTH=7

# Var-resolve bags for change_impact (method_var_resolve). Auto on API start / first request.
# No manual sync_var_resolve_entry.py needed for daily use.
VAR_RESOLVE_AUTO_ENSURE=true
VAR_RESOLVE_STARTUP_ENSURE=true
VAR_RESOLVE_DEFAULT_ENTRY=WithdrawalsController#withdrawals
VAR_RESOLVE_PACKAGE_ROOTS=loan-service/src/main/java
VAR_RESOLVE_HOP=2
VAR_RESOLVE_MIN_BAGS=5

# LangSmith（https://smith.langchain.com ）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=business-code-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===== 问答双赢优化开关（默认全部开启；置 false 即可单点回滚）=====
# 进程内 LRU 缓存 hybrid_search/embedding 结果（追问/相似问直接命中，跳过 Milvus+MySQL）
# SEARCH_CACHE_ENABLED=true
# SEARCH_CACHE_MAX_EMBED=512
# SEARCH_CACHE_MAX_SEARCH=256
# 会话证据继承：追问轮复用上一轮已读证据，禁止重复 get_symbol_code
# AGENT_EVIDENCE_REUSE=true
# EVIDENCE_REUSE_MAX_CHARS=2400
# 用户点「有用」自动回填黄金问答库（source=manual_feedback；命中即免长链）
# GOLDEN_QA_BACKFILL_ENABLED=true
